<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>true</IsPackable>
        <PackageId>ZmqSharp</PackageId>
        <!-- Package version is injected by the publish workflow (-p:Version=<tag version>);
             no Version property here so the file never drifts from the released version.
             A local `dotnet pack` therefore defaults to 1.0.0 - only for local experiments. -->
        <Authors>ZmqSharp contributors</Authors>
        <Description>A fully asynchronous, AOT-compatible ZMTP 3.0 / ZeroMQ library for .NET with libzmq-compatible socket semantics.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/ghostflyby/ZmqSharp</RepositoryUrl>
        <PackageTags>zmq;zmtp;zeromq;networking;messaging</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ZmqSharp.Tests"/>
        <InternalsVisibleTo Include="ZmqSharp.AllocationTests"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
        <None Include="../NOTICE" Pack="true" PackagePath="/"/>
        <None Include="../LICENSE" Pack="true" PackagePath="/"/>
    </ItemGroup>

</Project>
