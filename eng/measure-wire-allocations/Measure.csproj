<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LibraryRoot Condition="'$(LibraryRoot)' == ''">$(MSBuildThisFileDirectory)../..</LibraryRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LibraryRoot)/ZmqSharp/ZmqSharp.csproj" />
    <ProjectReference Include="$(LibraryRoot)/ZmqSharp.Security.Curve/ZmqSharp.Security.Curve.csproj" />
  </ItemGroup>
</Project>
